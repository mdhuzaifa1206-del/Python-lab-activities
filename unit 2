    otp = random.randint(10**(n - 1), 10**n - 1)
    print("OTP =", otp)
else:
    print("Please enter either 4 or 6")


# 5. Fibonacci Series Using Recursion

def fibonacci(n):
    if n == 0 or n == 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

n = int(input("Enter number of terms: "))

for i in range(n):
    print(fibonacci(i), end=" ")

